{
  "info": {
    "_postman_id": "464c8cd1-bd0e-40cc-ae2c-0512b07f33f6",
    "name": "Foodmine API Testing - E2E Workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "50452131",
    "_collection_link": "https://go.postman.co/collection/50452131-464c8cd1-bd0e-40cc-ae2c-0512b07f33f6?source=collection_link",
    "description": "Foodmine API end-to-end workflow covering authentication, food retrieval, order workflow, and negative scenarios. Register User generates a unique test email and Login User reuses it during the same collection run."
  },
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const testEmail = `roka${Date.now()}@test.com`;",
                  "pm.environment.set(\"testEmail\", testEmail);",
                  "pm.environment.set(\"testPassword\", \"12345\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token exists\", function () {\r",
                  "    pm.expect(res.token).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User email exists\", function () {\r",
                  "    pm.expect(res.email).to.include(\"@test.com\");\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", res.token);\r",
                  "pm.environment.set(\"userId\", res.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Roka\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"address\": \"Cairo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Login returns token\", function () {\r",
                  "    pm.expect(res.token).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", res.token);\r",
                  "pm.environment.set(\"userId\", res.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Food APIs",
      "item": [
        {
          "name": "Get All Foods",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is array\", function () {\r",
                  "    pm.expect(res).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Food list is not empty\", function () {\r",
                  "    pm.expect(res.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"foodId\", res[0].id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Order Workflow",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 201 or 200\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order id exists\", function () {\r",
                  "    pm.expect(res.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order status is NEW\", function () {\r",
                  "    pm.expect(res.status).to.eql(\"NEW\");\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"orderId\", res.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Roka\",\r\n  \"address\": \"Cairo, Egypt\",\r\n  \"addressLatLng\": {\r\n    \"lat\": \"30.0444\",\r\n    \"lng\": \"31.2357\"\r\n  },\r\n  \"totalPrice\": 12.99,\r\n  \"items\": [\r\n    {\r\n      \"food\": \"{{foodId}}\",\r\n      \"quantity\": 1,\r\n      \"price\": 12.99\r\n    }\r\n  ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "create"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Track Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Tracked order id matches saved orderId\", function () {\r",
                  "    pm.expect(res.id).to.eql(pm.environment.get(\"orderId\"));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order has valid status\", function () {\r",
                  "    pm.expect([\"NEW\", \"PAYED\", \"SHIPPED\", \"CANCELED\", \"REFUNDED\"]).to.include(res.status);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/track/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "track",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Pay Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Payment request successful\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response body exists\", function () {\r",
                  "    pm.expect(res).to.be.an(\"object\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"paymentId\": \"{{paymentId}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "pay"
              ]
            }
          },
          "response": []
        }
      ]
    },
